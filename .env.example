NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (project: remotewiseteams / xnqwkbwsjsqoyqjbieyz)
NEXT_PUBLIC_SUPABASE_URL=https://xnqwkbwsjsqoyqjbieyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required to persist invites (bypasses RLS on public accept/invite routes).
# Dashboard → Project Settings → API → service_role (secret). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Auth / JWT
INVITE_JWT_SECRET=

# Resend (transactional email). Leave empty to skip sending in local/dev.
# Dashboard: https://resend.com/api-keys  → create key, verify sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=RemoteWise <billing@remotewise.dev>

# Stripe TEST mode (sk_test_ / pk_test_ only until production promote).
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → Add endpoint → POST {APP_URL}/api/stripe/webhook
# Events: checkout.session.completed, payment_intent.succeeded, account.updated, transfer.created, payout.paid
STRIPE_WEBHOOK_SECRET=

# Optional observability. Empty = no-op (app still runs).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
